    {
        "id": "4703b560fa594d0d",
        "type": "function",
        "z": "33698b568f6037bd",
        "name": "ToDMXFixtures",
        "func": "// Receive parsed JSON data from Arduino\nvar statusArray = msg.payload.data;\nvar isSolved = msg.payload.solved;\nvar isWrong = msg.payload.wrong || false; \n\nvar lastSentLights = flow.get('lastSentLights') || [0, 0, 0, 0, 0];\nvar lastSolved = flow.get('lastSolved') || false;\n\n// Animation playback state tracker\nvar isAnimPlaying = flow.get('isAnimPlaying') || false; \n\nvar msgsToSend = []; \n\n// 0. Highest priority: wrong item sound effect\nif (isWrong) {\n    msgsToSend.push({ topic: \"/cue/wrong/start\", payload: \"\" });\n}\n\n// 1. Solved / reset state handling\nif (isSolved !== lastSolved) {\n    if (isSolved === true) {\n        // Trigger the QLab win cue immediately\n        msgsToSend.push({ topic: \"/cue/WIN/start\", payload: \"\" });\n\n        // Turn on all 5 individual ritual lights for the highlight moment\n        for (let i = 0; i < 5; i++) {\n            if (statusArray[i] !== lastSentLights[i]) {\n                msgsToSend.push({ topic: \"/ritual/light/\" + (i + 1), payload: 1 });\n                lastSentLights[i] = 1;\n            }\n        }\n\n        // Schedule the blackout phase:\n        // after 2 seconds, turn off the individual lights with a staggered offset\n        setTimeout(function () {\n            for (let i = 0; i < 5; i++) {\n                setTimeout(function () {\n                    node.send([{ topic: \"/ritual/light/\" + (i + 1), payload: 0 }, null, null]);\n                }, i * 30);\n                lastSentLights[i] = 0;\n            }\n            flow.set('lastSentLights', lastSentLights);\n        }, 2000);\n\n        // Precise toggle control:\n        // only send \"1\" to start the win animation if it is not already playing\n        if (!isAnimPlaying) {\n            node.send([null, { topic: \"/ritual/win_anim\", payload: 1 }, null]);\n            flow.set('isAnimPlaying', true); // Update memory: animation is now playing\n        }\n\n    } else {\n        // =====================================\n        // Player removed an item or GM pressed Reset\n        // =====================================\n        var resetMsgs = [];\n        \n        // Precise toggle control:\n        // if the animation is still playing, send a \"1\" to force-toggle it off\n        if (isAnimPlaying) {\n            resetMsgs.push({ topic: \"/ritual/win_anim\", payload: 1 });\n            flow.set('isAnimPlaying', false); // Update memory: animation is now off\n        }\n\n        // Individual ritual lights use flash behavior, so sending 0 releases them\n        for (var j = 1; j <= 5; j++) {\n            resetMsgs.push({ topic: \"/ritual/light/\" + j, payload: 0 });\n        }\n        \n        node.send([null, null, resetMsgs]);\n        lastSentLights = [0, 0, 0, 0, 0];\n    }\n\n    flow.set('lastSolved', isSolved);\n    flow.set('lastSentLights', lastSentLights);\n\n    if (msgsToSend.length > 0) {\n        node.send([msgsToSend, null, null]);\n    }\n    return null; \n}\n\n// 2. Normal item placement logic while the puzzle is unsolved\nif (!isSolved) {\n    for (let i = 0; i < 5; i++) {\n        if (statusArray[i] !== lastSentLights[i]) {\n            \n            // Sound effect for placing a correct item\n            if (statusArray[i] === 1) {\n                msgsToSend.push({ topic: \"/cue/candle/start\", payload: \"\" });\n            }\n\n            // Staggered light update\n            let lightIndex = i + 1;\n            let lightState = statusArray[i];\n            setTimeout(function () {\n                node.send([{ topic: \"/ritual/light/\" + lightIndex, payload: lightState }, null, null]);\n            }, i * 30);\n\n            lastSentLights[i] = statusArray[i];\n        }\n    }\n    flow.set('lastSentLights', lastSentLights);\n}\n\nif (msgsToSend.length > 0) {\n    node.send([msgsToSend, null, null]);\n}\nreturn null;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
