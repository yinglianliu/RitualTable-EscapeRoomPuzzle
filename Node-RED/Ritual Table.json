        "id": "e70ee9a0110a4776",
        "type": "function",
        "z": "e0d4d91d3c0f5107",
        "name": "SplitStateData",
        "func": "// Input data format: { \"data\": [1,0,1,0,0], \"solved\": false, \"wrong\":false }\n\nvar states = msg.payload.data;\nvar isSolved = msg.payload.solved;\n\nfunction toBool(val) {\n    return val == 1;\n}\n\n// Send status to the 5 dashboard LEDs\nvar msg1 = { payload: toBool(states[0]) };\nvar msg2 = { payload: toBool(states[1]) };\nvar msg3 = { payload: toBool(states[2]) };\nvar msg4 = { payload: toBool(states[3]) };\nvar msg5 = { payload: toBool(states[4]) };\n\n// Status text for the dashboard\nvar msgSolved = { payload: isSolved ? \"PUZZLE SOLVED!\" : \"Waiting...\" };\n\nreturn [msg1, msg2, msg3, msg4, msg5, msgSolved];",
