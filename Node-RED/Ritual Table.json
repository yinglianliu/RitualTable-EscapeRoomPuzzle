        "order": 3,
        "width": 0,
        "height": 0,
        "format": "<div layout=\"row\" layout-align=\"center center\">\n    <md-button class=\"md-raised\" style=\"background-color: #273746; color: black; width: 100%; font-weight: bold;\"\n        ng-click=\"checkShutdown()\">\n        🛑 SHUTDOWN SYSTEM\n    </md-button>\n</div>\n\n<script>\n    (function($scope) {\n    $scope.checkShutdown = function() {\n        var result = confirm(\"🛑 DANGER 🛑\\n\\nAre you sure you want to SHUTDOWN the Raspberry Pi?\\nYou will need to physically power cycle the Pi to turn it back on.\");\n        if (result) {\n            $scope.send({\n                payload: \"shutdown\"\n            });\n        }\n    }\n})(scope);\n</script>",
