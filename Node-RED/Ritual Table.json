    {
        "id": "6055941e8c744a4a",
        "type": "function",
        "z": "f4338a68ae18fd22",
        "name": "ToDMXFixtures",
        "func": "var statusArray = msg.payload.data;\nvar isSolved = msg.payload.solved;\n\nvar lastSentLights = flow.get('lastSentLights') || [0, 0, 0, 0, 0];\nvar lastSolved = flow.get('lastSolved') || false;\n\nif (isSolved !== lastSolved) {\n    if (isSolved === true) {\n        // ==========================================\n        // Puzzle just solved\n        // ==========================================\n\n        // 1. Turn on all 5 lights first and hold the fully lit state for 2 seconds\n        for (let i = 0; i < 5; i++) {\n            if (statusArray[i] !== lastSentLights[i]) {\n                node.send([{ topic: \"/ritual/light/\" + (i + 1), payload: 1 }, null, null]);\n                lastSentLights[i] = 1;\n            }\n        }\n\n        // 2. Schedule the blackout phase: after 2000 ms,\n        //    turn off all lights with a staggered offset\n        setTimeout(function () {\n            for (let i = 0; i < 5; i++) {\n                setTimeout(function () {\n                    node.send([{ topic: \"/ritual/light/\" + (i + 1), payload: 0 }, null, null]);\n                }, i * 30);\n\n                lastSentLights[i] = 0; // Update stored state to OFF\n            }\n            flow.set('lastSentLights', lastSentLights);\n        }, 2000);\n\n        // 3. Send the win animation trigger to output 2.\n        //    This output passes through the downstream delay nodes before\n        //    the final full-light state is restored.\n        node.send([null, { topic: \"/ritual/win_anim\", payload: 1 }, null]);\n\n    } else {\n        // ==========================================\n        // GM reset\n        // ==========================================\n        var resetMsgs = [{ topic: \"/ritual/win_anim\", payload: 0 }];\n        for (var j = 1; j <= 5; j++) resetMsgs.push({ topic: \"/ritual/light/\" + j, payload: 0 });\n\n        node.send([null, null, resetMsgs]); // Use output 3 for immediate reset\n        lastSentLights = [0, 0, 0, 0, 0];\n    }\n\n    flow.set('lastSolved', isSolved);\n    flow.set('lastSentLights', lastSentLights);\n\n    return null; // Exit after solved/reset handling is complete\n}\n\n// ==========================================\n// Normal item placement logic (while unsolved)\n// ==========================================\nif (!isSolved) {\n    for (let i = 0; i < 5; i++) {\n        if (statusArray[i] !== lastSentLights[i]) {\n            // Normal staggered light on/off update\n            setTimeout(function () {\n                node.send([{ topic: \"/ritual/light/\" + (i + 1), payload: statusArray[i] }, null, null]);\n            }, i * 30);\n\n            lastSentLights[i] = statusArray[i];\n        }\n    }\n    flow.set('lastSentLights', lastSentLights);\n}\n\nreturn null;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
