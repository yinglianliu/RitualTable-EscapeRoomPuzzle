    {
        "id": "8218fd753f517774",
        "type": "function",
        "z": "e0d4d91d3c0f5107",
        "name": "SystemConductor",
        "func": "var statusArray = msg.payload.data;\nvar isSolved = msg.payload.solved;\nvar isWrong = msg.payload.wrong || false;\n\nvar lastSentLights = flow.get('lastSentLights') || [0, 0, 0, 0, 0];\nvar lastSolved = flow.get('lastSolved') || false;\nvar isAnimPlaying = flow.get('isAnimPlaying') || false;\n\nvar msgsToSend = []; // Unified broadcast packet\n\n// 0. Wrong placement alarm\nif (isWrong) msgsToSend.push({ topic: \"/cue/WRONG/start\", payload: \"\" });\n\n// 1. Solved / reset state handling\nif (isSolved !== lastSolved) {\n    if (isSolved === true) {\n        // 1. Starting signal: launch the timeline trigger\n        msgsToSend.push({ topic: \"/ritual/timeline/start\", payload: \"\" });\n\n        // 2. Dramatic blackout: force all 5 individual lights OFF\n        //    while the downstream effects system takes over\n        for (let i = 0; i < 5; i++) {\n            msgsToSend.push({ topic: \"/ritual/light/\" + (i + 1), payload: 0 });\n            lastSentLights[i] = 0; // Store the current OFF state\n        }\n\n        // Note: the actual animation trigger is no longer sent here.\n        // It is now handled by the dedicated timeline branch below.\n        flow.set('isAnimPlaying', true); // Internal state marker only\n    } else {\n        // Reset the game: send 0 to turn off all individual lights\n        for (var j = 1; j <= 5; j++) msgsToSend.push({ topic: \"/ritual/light/\" + j, payload: 0 });\n\n        // [Fix]: If the completion animation is currently playing, simulate a \"perfect click\" to close the Toggle button.\n        if (isAnimPlaying) {\n            msgsToSend.push({ topic: \"/ritual/win_anim\", payload: 255 }); // pressed\n            msgsToSend.push({ topic: \"/ritual/win_anim\", payload: 0 });   // released\n        }\n\n        msgsToSend.push({ topic: \"/cue/WIN/cancel\", payload: \"\" });\n        msgsToSend.push({ topic: \"/cue/WIN/stop\", payload: \"\" });\n\n        lastSentLights = [0, 0, 0, 0, 0];\n        flow.set('isAnimPlaying', false);\n    }\n\n    flow.set('lastSolved', isSolved);\n    flow.set('lastSentLights', lastSentLights);\n}\n\n// 2. Normal item placement logic\nif (!isSolved) {\n    for (let i = 0; i < 5; i++) {\n        if (statusArray[i] !== lastSentLights[i]) {\n            if (statusArray[i] === 1) msgsToSend.push({ topic: \"/cue/CANDLE/start\", payload: \"\" });\n\n            // [Brightness Protection]: Converts the value '1' received from Arduino into '255', \n            //ensuring that the lighting within QLC+ reaches 100% full brightness.\n            var brightness = (statusArray[i] === 1) ? 255 : 0;\n            msgsToSend.push({ topic: \"/ritual/light/\" + (i + 1), payload: brightness });\n\n            lastSentLights[i] = statusArray[i];\n        }\n    }\n    flow.set('lastSentLights', lastSentLights);\n}\n\n// Unified output: send all accumulated commands in a single packet\nif (msgsToSend.length > 0) {\n    return [msgsToSend];\n}\nreturn null;",
