    {
        "id": "4703b560fa594d0d",
        "type": "function",
        "z": "33698b568f6037bd",
        "name": "SystemConductor",
        "func": "\nvar statusArray = msg.payload.data;\nvar isSolved = msg.payload.solved;\nvar isWrong = msg.payload.wrong || false; \n\nvar lastSentLights = flow.get('lastSentLights') || [0, 0, 0, 0, 0];\nvar lastSolved = flow.get('lastSolved') || false;\nvar isAnimPlaying = flow.get('isAnimPlaying') || false; \n\nvar msgsToSend = []; // Unified broadcast packet\n\n// 0. Wrong placement alarm\nif (isWrong) msgsToSend.push({ topic: \"/cue/WRONG/start\", payload: \"\" });\n\n// 1. Solved / reset state handling\nif (isSolved !== lastSolved) {\n    if (isSolved === true) {\n       // 1. Starting signal: launch the timeline trigger\n       msgsToSend.push({ topic: \"/ritual/timeline/start\", payload: \"\" });\n\n        // 2. Dramatic blackout: force all 5 individual lights OFF\n        //    while the downstream effects system takes over\n        for (let i = 0; i < 5; i++) {\n            msgsToSend.push({ topic: \"/ritual/light/\" + (i + 1), payload: 0 });\n            lastSentLights[i] = 0; // Store the current OFF state\n        }\n\n        // Note: the actual animation trigger is no longer sent here.\n        // It is now handled by the dedicated timeline branch below.\n        flow.set('isAnimPlaying', true); // Internal state marker only\n    } else {\n        // Reset the game: send 0 to turn off all individual lights\n        // and reset the QLC+ animation button state\n        for (var j = 1; j <= 5; j++) msgsToSend.push({ topic: \"/ritual/light/\" + j, payload: 0 });\n        msgsToSend.push({ topic: \"/ritual/win_anim\", payload: 0 }); // Stop any stuck toggle animation\n        \n        msgsToSend.push({ topic: \"/cue/WIN/cancel\", payload: \"\" });\n        msgsToSend.push({ topic: \"/cue/WIN/stop\", payload: \"\" });\n        \n        lastSentLights = [0, 0, 0, 0, 0];\n        flow.set('isAnimPlaying', false);\n    }\n\n    flow.set('lastSolved', isSolved);\n    flow.set('lastSentLights', lastSentLights);\n}\n\n// 2. Normal item placement logic\nif (!isSolved) {\n    for (let i = 0; i < 5; i++) {\n        if (statusArray[i] !== lastSentLights[i]) {\n            if (statusArray[i] === 1) msgsToSend.push({ topic: \"/cue/CANDLE/start\", payload: \"\" });\n            msgsToSend.push({ topic: \"/ritual/light/\" + (i+1), payload: statusArray[i] });\n            lastSentLights[i] = statusArray[i];\n        }\n    }\n    flow.set('lastSentLights', lastSentLights);\n}\n\n// Unified output: send all accumulated commands in a single packet\nif (msgsToSend.length > 0) {\n    return [msgsToSend]; \n}\nreturn null;",
