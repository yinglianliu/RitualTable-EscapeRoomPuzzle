    {
        "id": "e57c3c18ef57e0ce",
        "type": "function",
        "z": "33698b568f6037bd",
        "name": "function 1",
        "func": "var msgs = [];\nvar lastSentLights = flow.get('lastSentLights') || [0, 0, 0, 0, 0];\nvar isAnimPlaying = flow.get('isAnimPlaying') || false;\n\n// 1. When the timer ends, send \"1\" to force-toggle the win animation off\nif (isAnimPlaying) {\n    msgs.push({ topic: \"/ritual/win_anim\", payload: 1 });\n    flow.set('isAnimPlaying', false); // Update memory: animation has ended\n}\n\n// 2. Turn all 5 ritual lights back on and hold the fully lit state\nfor (var i = 0; i < 5; i++) {\n    msgs.push({ topic: \"/ritual/light/\" + (i + 1), payload: 1 });\n    lastSentLights[i] = 1; \n}\n\nflow.set('lastSentLights', lastSentLights);\nreturn [msgs];",
