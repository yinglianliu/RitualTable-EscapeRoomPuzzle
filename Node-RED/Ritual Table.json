        "func": "// This node is triggered after the upstream delay chain completes\n// (currently 1650 ms + 3 seconds after the win animation trigger)\n\nvar msgs = [];\n// Retrieve the shared lighting state memory\nvar lastSentLights = flow.get('lastSentLights') || [0, 0, 0, 0, 0];\n\n// 1. Force QLC+ win animation OFF\nmsgs.push({ topic: \"/ritual/win_anim\", payload: 0 });\n\n// 2. Turn all 5 ritual lights back on and hold the fully lit state\nfor (var i = 0; i < 5; i++) {\n    msgs.push({ topic: \"/ritual/light/\" + (i + 1), payload: 1 });\n    lastSentLights[i] = 1; // Important: keep memory synchronized with the actual light state\n}\n\n// Save updated memory\nflow.set('lastSentLights', lastSentLights);\n\n// Output the packaged commands directly\nreturn [msgs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
