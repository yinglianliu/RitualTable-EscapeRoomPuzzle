        "format": "<div layout=\"row\" layout-align=\"center center\">\n    <md-button class=\"md-raised\" style=\"background-color: orange; color: white; width: 100%; font-weight: bold;\"\n        ng-click=\"checkForceWin()\">\n        ⚠️ FORCE WIN\n    </md-button>\n</div>\n\n<script>\n    (function($scope) {\n    // \n    $scope.checkForceWin = function() {\n        // \n        var result = confirm(\"⚠️ Warning ⚠️\\n\\nAre you sure you want to force the puzzle into the solved state?\\nThis will trigger the win lighting and animation sequence.\");\n        \n        if (result) {\n            // \n            $scope.send({\n                payload: \"F\"\n            });\n        }\n    }\n})(scope);\n</script>",
